<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="timertaskserver.workserver.data.swzzwater.RTSQBZKDData">
    <select id="selectList" resultType="timertaskserver.workserver.pojo.swzzwater.RTSQBZKDPojo">
        select * from HPJSQ.RTSQBZKD
        <where>
            <if test="idList != null and idList.size() > 0">
                and SENID in
                <foreach collection="idList" open="(" close=")" item="stcd" separator=",">
                    #{stcd}
                </foreach>
            </if>
            <if test="stime != null and stime != ''">
                <![CDATA[ and TIME > #{stime} ]]>
            </if>
            <if test="etime != null and etime != ''">
                <![CDATA[ and TIME <= #{etime} ]]>
            </if>
        </where>
        order by TIME asc
    </select>
</mapper>